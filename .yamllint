---
# The workflows use long `run:` lines and GitHub's `on:` key, which yamllint's
# default profile objects to.
extends: default

# Hydra's builtin config group, copied verbatim (see ATTRIBUTION/). Editing it
# to satisfy a linter would break the property that makes it auditable against
# upstream -- the same reason the two ported Python modules are exempt from
# ruff.
ignore: |
  src/hydra_fast/conf/

rules:
  line-length:
    max: 120
    # Shell commands inside `run:` blocks cannot always be wrapped.
    allow-non-breakable-words: true
  truthy:
    # GitHub Actions' `on:` trigger key is not a boolean.
    allowed-values: ["true", "false"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  document-start:
    # Required, matching the convention the workflow files already use.
    present: true
