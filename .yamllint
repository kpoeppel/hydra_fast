---
# The workflows use long `run:` lines and GitHub's `on:` key, which yamllint's
# default profile objects to.
extends: default

# Two exemptions, both because the files have to look like what they stand in
# for rather than what a YAML linter prefers:
#
# src/hydra_fast/conf/ is Hydra's builtin config group, copied verbatim (see
# ATTRIBUTION/) -- editing it would break the property that makes it auditable
# against upstream, the same reason the two ported Python modules are exempt
# from ruff.
#
# tests/realistic_config/ is a fixture standing in for a real hydra config
# tree. Hydra configs do not carry `---` document starts: zero of the 236
# files in the production tree this one is modelled on have one, so requiring
# it would make the fixture unrepresentative of the thing it exists to test.
ignore: |
  src/hydra_fast/conf/
  tests/realistic_config/

rules:
  line-length:
    max: 120
    # Shell commands inside `run:` blocks cannot always be wrapped.
    allow-non-breakable-words: true
  truthy:
    # GitHub Actions' `on:` trigger key is not a boolean.
    allowed-values: ["true", "false"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  document-start:
    # Required, matching the convention the workflow files already use.
    present: true
